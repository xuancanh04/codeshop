# Optional: show “Stripe ready” banner on checkout when key looks valid (pk_…).
# Real payments still require a backend (PaymentIntent / Checkout Session).
VITE_STRIPE_PUBLISHABLE_KEY=

# Catalog — mock (default) or your backend
# Unset VITE_USE_MOCK_CATALOG or set to "true" → uses src/mocks/catalog/*.js
# Set VITE_USE_MOCK_CATALOG=false and VITE_API_URL → HTTP (see src/api/catalogApi.js)
#   GET {VITE_API_URL}/projects
#   GET {VITE_API_URL}/projects/:id
# VITE_USE_MOCK_CATALOG=false
# VITE_API_URL=http://localhost:4000/api
